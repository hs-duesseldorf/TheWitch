# Ports
WITCH_AI_UI_PORT=8080
WITCH_AI_PORT=8081
WITCH_LLM_PORT=8082
WITCH_TTS_PORT=8083

# URLs
# Set each host to the machine that runs that service.
# Same Docker host: host.docker.internal
# LAN: the service machine IP/hostname, e.g. 10.30.28.103
# Jetson USB link to main PC: 192.168.55.100
WITCH_LLM_HOST=host.docker.internal
WITCH_TTS_HOST=host.docker.internal
WITCH_AI_HOST=host.docker.internal
WITCH_LLM_BASE_URL=http://${WITCH_LLM_HOST}:${WITCH_LLM_PORT}
WITCH_TTS_BASE_URL=http://${WITCH_TTS_HOST}:${WITCH_TTS_PORT}
WITCH_AI_BASE_URL=ws://${WITCH_AI_HOST}:${WITCH_AI_PORT}

# Camera
WITCH_CAMERA_SOURCE=0

# AI Models
WITCH_LLM_MODEL=qwen2.5:1.5b
WITCH_TTS_MODEL=tts_models/de/thorsten/vits

# Seat Sensor
WITCH_SEAT_SENSOR_OVERRIDE=true
