# Internal container ports (for run_vllm.sh)
WITCH_LLM_PORT=10032
WITCH_TTS_PORT=10033

# External mapped ports (for client connecting via host)
WITCH_LLM_PORT_EXT=33533
WITCH_TTS_PORT_EXT=41333

# Other ports
WITCH_AI_UI_PORT=10030
WITCH_AI_PORT=10031
WITCH_AUDIO_BRIDGE_PORT=10034

# Local Python on this machine: localhost
#WITCH_AI_HOST=localhost
#WITCH_LLM_HOST=localhost
#WITCH_TTS_HOST=localhost

# Jetson USB link to main PC: 192.168.55.100
# WITCH_AI_HOST=192.168.55.100

# LAN: the machine IP (use _EXT ports above)
WITCH_LLM_HOST=10.50.60.111
WITCH_TTS_HOST=10.50.60.111

# Container host gateway
WITCH_AI_HOST=host.containers.internal

# Camera
WITCH_CAMERA_SOURCE=0

WITCH_AUDIO_PLAY_HOST=localhost

# AI Models - Using llama.cpp for LLM, vLLM-omni for TTS
WITCH_LLM_HF=unsloth/Qwen3-4B-GGUF:Qwen3-4B-Q4_K_M.gguf
WITCH_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# Server runtime settings
LLM_MAX_MODEL_LEN=2048
LLM_N_GPU_LAYERS=999
TTS_MAX_MODEL_LEN=512
TTS_GPU_MEMORY_UTILIZATION=0.35

# Seat Sensor
WITCH_SEAT_SENSOR_OVERRIDE=true
