# AI Websocket Server URL
WITCH_WS_BASE_URL=ws://0.0.0.0:8765

# LLM/TTS URLs. Change to custom URL if offloading to Cloud
WITCH_LLM_BASE_URL=http://llm:11434
WITCH_TTS_BASE_URL=http://tts:5002
# LLM to pull & use
WITCH_LLM_MODEL=qwen2.5:1.5b

# ImageProcessing -> AI routing. On Jetson, set this to ws://<AI-machine-LAN-IP>:8765.
IP_AI_BASE_URL=ws://ai:8765
