# Other ports
WITCH_AI_UI_PORT=8080
WITCH_AI_PORT=8081

# Service ports
# Put these on local pc
WITCH_LLM_PORT=33533
WITCH_TTS_PORT=41333
# Put these on server
#WITCH_LLM_PORT=10032
#WITCH_TTS_PORT=10033

# Put this on jetson
#WITCH_AI_HOST=192.168.55.100
# Put this on local pc
WITCH_AI_HOST=127.0.0.1

# Local venv services on this machine
WITCH_LLM_HOST=10.50.60.111
WITCH_TTS_HOST=10.50.60.111

# Camera
WITCH_CAMERA_SOURCE=0

# AI Models - Using Ollama for LLM, vLLM-omni for TTS
WITCH_OLLAMA_MODEL=hf.co/unsloth/Qwen3-8B-GGUF:Qwen3-8B-Q4_K_M.gguf
WITCH_VIRTUAL_CABLE_NAME=Virtual Cable
WITCH_SPEAKER_DELAY_SECONDS=0.2
WITCH_AUDIO_PREBUFFER_SECONDS=5.0
WITCH_EVENT_STABILITY_SECONDS=0.5

# TTS server voice profile
WITCH_TTS_VOICE_NAME=witch
WITCH_TTS_LANGUAGE=German
WITCH_TTS_BASE_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
WITCH_TTS_VOICE_DESIGN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
WITCH_TTS_ANCHOR_TEXT=Schließen Sie ihre Augen. Zeigen Sie mir ihre Hand.
WITCH_TTS_VOICE_DESCRIPTION=A very calm, very slow middle-aged female German voice with a natural Asian accent and subtle Korean cadence. Low-pitched, warm, mature, soft, steady, and quietly mysterious. She speaks with long pauses, restrained emotion, stable pitch, and gentle, deliberate pacing.

# TTS generation parameters
WITCH_TTS_TEMPERATURE=0.9
WITCH_TTS_REPETITION_PENALTY=1.05
WITCH_TTS_MAX_DURATION_SECONDS=120

# Server runtime settings
LLM_MAX_MODEL_LEN=2048
LLM_N_GPU_LAYERS=999
TTS_MAX_MODEL_LEN=8192
TTS_MAX_NEW_TOKENS=2048
TTS_GPU_MEMORY_UTILIZATION=0.35

# Seat Sensor
WITCH_SEAT_SENSOR_OVERRIDE=true
WITCH_LD2410S_PORT=/dev/ttyUSB0
WITCH_LD2410S_ROOM_MAX_MM=3500
WITCH_LD2410S_SEATED_MAX_MM=1000

# LEDs
WITCH_LED_PIN=15

# Wait for Unreal to acknowledge events before advancing
# Set to false to skip waiting for EventDoneEvent responses from Unreal
WITCH_WAIT_FOR_UNREAL_ACK=false

WITCH_GASLIGHT=true
WITCH_DEBUG_COOLDOWN_SECONDS=2.0
WITCH_EVENT_HEARTBEAT_SECONDS=0.5
