# Ports
WITCH_AI_UI_PORT=10030
WITCH_AI_PORT=10031
WITCH_LLM_PORT=10032
WITCH_TTS_PORT=10033

# URLs
# Set each host to the machine that runs that service.
# Same Podman host: host.containers.internal
# Local Python on this machine: localhost
# LAN: the service machine IP/hostname, e.g. 10.30.28.103
# Jetson USB link to main PC: 192.168.55.100
WITCH_LLM_HOST=host.containers.internal
WITCH_TTS_HOST=host.containers.internal
WITCH_AI_HOST=host.containers.internal
# WITCH_LLM_HOST=localhost
# WITCH_TTS_HOST=localhost
# WITCH_AI_HOST=localhost

# Camera
# Local USB camera on Linux/Jetson: 0
WITCH_CAMERA_SOURCE=0

# AI Models
WITCH_LLM_MODEL=qwen2.5:1.5b
WITCH_TTS_MODEL=tts_models/de/thorsten/vits

# Seat Sensor
WITCH_SEAT_SENSOR_OVERRIDE=true
