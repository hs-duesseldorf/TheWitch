ARG BASE_IMAGE=docker.io/python:3.11-slim
FROM ${BASE_IMAGE}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libegl1 \
    libgles2 \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY ImageProcessing/requirements.txt ./ImageProcessing/requirements.txt

ARG INSTALL_TORCH=1
RUN if [ "$INSTALL_TORCH" = "1" ]; then \
      PIP_CONSTRAINT= pip install --no-cache-dir -r ImageProcessing/requirements.txt; \
    else \
      grep -Ev '^(torch|torchvision)==' ImageProcessing/requirements.txt > /tmp/requirements-no-torch.txt && \
      PIP_CONSTRAINT= pip install --no-cache-dir -r /tmp/requirements-no-torch.txt; \
    fi

COPY shared/ ./shared/
COPY ImageProcessing/ ./ImageProcessing/

CMD ["python", "-m", "ImageProcessing.main"]
